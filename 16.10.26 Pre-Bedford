def autonomous():
    motor_group_left.spin(FORWARD, 70, PERCENT)
    motor_group_right.spin(FORWARD, 70, PERCENT)
    lift_motor_group.spin(FORWARD, 100, PERCENT)
    wait(0.6, SECONDS)
    motor_group_left.stop()
    motor_group_right.stop()
    lift_motor_group.stop()
    wait(0.4, SECONDS)
    motor_group_left.spin(REVERSE, 100, PERCENT)
    motor_group_right.spin(FORWARD, 100, PERCENT)
    wait(0.2, SECONDS)
    motor_group_left.stop()
    motor_group_right.stop()
    wait(0.5, SECONDS)
    motor_group_left.spin(FORWARD, 100, PERCENT)
    motor_group_right.spin(FORWARD, 100, PERCENT)
    wait(0.7, SECONDS)
    motor_group_left.stop()
    motor_group_right.stop()
    lift_motor_group.spin(REVERSE, 100, PERCENT)
    wait(1, SECONDS)
    motor_group_left.stop()
    motor_group_right.stop()
    Claw.open()
    Claw.open()
    wait(0.2, SECONDS)
    lift_motor_group.spin(FORWARD, 100, PERCENT)
    motor_group_left.spin(REVERSE, 100, PERCENT)
    motor_group_right.spin(REVERSE, 100, PERCENT)
    wait(0.7, SECONDS)
    motor_group_left.stop()
    motor_group_right.stop()
    wait(0.8, SECONDS)
    lift_motor_group.stop()
    motor_group_left.spin(REVERSE, 100, PERCENT)
    motor_group_right.spin(FORWARD, 100, PERCENT)
    wait(0.2, SECONDS)
    motor_group_left.spin(FORWARD, 100, PERCENT)
    motor_group_right.spin(FORWARD, 100, PERCENT)
    wait(0.5, SECONDS)
    motor_group_left.stop()
    motor_group_right.stop()

    wait(15)

    Sensor_1.set_light(100, PERCENT)
    wait(0.6, SECONDS)
    while SenseColour()!="blue":
        brain.screen.next_row()      
        motor_group_left.spin(REVERSE, 100, PERCENT)
        motor_group_right.spin(REVERSE, 100, PERCENT)
        wait(1, SECONDS)
        motor_group_left.spin(FORWARD, 100, PERCENT)
        motor_group_right.spin(FORWARD, 100, PERCENT)
        wait(0.2, SECONDS)
        motor_group_right.stop()
        motor_group_left.stop()
        wait(0.5, SECONDS)
    Sensor_1.set_light(0, PERCENT)
