{"mode":"Text","hardwareTarget":"brain","textContent":"\"\"\"\nTO DO:\nCreate other motor objects for lifting mechanism and grabber.\nGet lifting system subroutines working. controller_2?\n\n\"\"\"\n\nfrom vex import *\n\nbrain = Brain()\n\ncontroller_1 = Controller(PRIMARY) ##This is the controller object so we can get input from the controls\ncontroller_2 = Controller(PARTNER)\n\nglobal Turn\nTurn=70\n\nglobal TankMode\nTankMode=False\n\nright_motor_front = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)\nright_motor_middle = Motor(Ports.PORT4, GearSetting.RATIO_18_1, False)\nright_motor_rear = Motor(Ports.PORT6, GearSetting.RATIO_18_1, False)\nmotor_group_right = MotorGroup(right_motor_front, right_motor_middle, right_motor_rear)\n\nleft_motor_front = Motor(Ports.PORT1, GearSetting.RATIO_18_1, True)\nleft_motor_middle = Motor(Ports.PORT3, GearSetting.RATIO_18_1, True)\nleft_motor_rear = Motor(Ports.PORT5, GearSetting.RATIO_18_1, True)\nmotor_group_left = MotorGroup(left_motor_front, left_motor_middle, left_motor_rear)\n\n#height_adjustment_motor = Motor(Ports.PORT7, GearSetting RATION_36_1, True)\n\n##Helper Method for debugging\ndef ScreenPrint(Message):\n    brain.screen.print(Message)\n    brain.screen.next_row()\n\ndef IncTurn():\n    global Turn\n    if Turn<100:\n        Turn+=5\n# \n\ndef DecTurn():\n    global Turn\n    if Turn>5:\n        Turn-=5\n#\n\n\ndef ToggleTankMode():\n    global TankMode\n    if TankMode:\n        TankMode = False\n        ScreenPrint(\"Tank Mode off\")\n    else:\n        TankMode = True\n        ScreenPrint(\"Tank Mode on\")\n\n\ndef user_control():\n    global TankMode\n    controller_1.buttonUp.pressed(IncTurn)\n    controller_1.buttonDown.pressed(DecTurn)\n    controller_1.buttonA.pressed(ToggleTankMode)\n\n    while True:\n    #MOTOR CONTROL\n        # Single joystick control\n        \n        if TankMode==False:\n            motor_group_left.set_velocity(controller_1.axis3.position() + (controller_1.axis4.position()*Turn/100), PERCENT)\n            motor_group_right.set_velocity(controller_1.axis3.position() - (controller_1.axis4.position()*Turn/100), PERCENT)\n        \n        # Tank mode\n        else:\n            motor_group_left.set_velocity(controller_1.axis3.position(), PERCENT)\n            motor_group_right.set_velocity(controller_1.axis2.position(), PERCENT)\n\n        #height_adjustment_motor.set_velocity(controller_2.axis3.position(), PERCENT)\n\n        #height_adjustment_motor.spin(FORWARD)\n        motor_group_right.spin(FORWARD)\n        motor_group_left.spin(FORWARD)\n        wait(5, MSEC)\n\ndef autonomous_skills():\n    pass\n\n# create competition instance\ncomp = Competition(user_control,autonomous_skills) # This calls the subroutines: we don't need to!\n\n# actions to do when the program starts\nbrain.screen.clear_screen()","textLanguage":"python","robotConfig":[],"slot":1,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}