"""
TO DO:
Create other motor objects for lifting mechanism and grabber.
Get lifting system subroutines working. controller_2?

"""

from vex import *

brain = Brain()

controller_1 = Controller(PRIMARY) ##This is the controller object so we can get input from the controls
controller_2 = Controller(PARTNER)

global Turn
Turn=70

global TankMode
TankMode=False

right_motor_front = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)
right_motor_middle = Motor(Ports.PORT4, GearSetting.RATIO_18_1, False)
right_motor_rear = Motor(Ports.PORT6, GearSetting.RATIO_18_1, False)
motor_group_right = MotorGroup(right_motor_front, right_motor_middle, right_motor_rear)

left_motor_front = Motor(Ports.PORT1, GearSetting.RATIO_18_1, True)
left_motor_middle = Motor(Ports.PORT3, GearSetting.RATIO_18_1, True)
left_motor_rear = Motor(Ports.PORT5, GearSetting.RATIO_18_1, True)
motor_group_left = MotorGroup(left_motor_front, left_motor_middle, left_motor_rear)

#height_adjustment_motor = Motor(Ports.PORT7, GearSetting RATION_36_1, True)

##Helper Method for debugging
def ScreenPrint(Message):
    brain.screen.print(Message)
    brain.screen.next_row()

def IncTurn():
    global Turn
    if Turn<100:
        Turn+=5
# 

def DecTurn():
    global Turn
    if Turn>5:
        Turn-=5
#


def ToggleTankMode():
    global TankMode
    if TankMode:
        TankMode = False
        ScreenPrint("Tank Mode off")
    else:
        TankMode = True
        ScreenPrint("Tank Mode on")


def user_control():
    global TankMode
    controller_1.buttonUp.pressed(IncTurn)
    controller_1.buttonDown.pressed(DecTurn)
    controller_1.buttonA.pressed(ToggleTankMode)

    while True:
    #MOTOR CONTROL
        # Single joystick control
        
        if TankMode==False:
            motor_group_left.set_velocity(controller_1.axis3.position() + (controller_1.axis4.position()*Turn/100), PERCENT)
            motor_group_right.set_velocity(controller_1.axis3.position() - (controller_1.axis4.position()*Turn/100), PERCENT)
        
        # Tank mode
        else:
            motor_group_left.set_velocity(controller_1.axis3.position(), PERCENT)
            motor_group_right.set_velocity(controller_1.axis2.position(), PERCENT)

        #height_adjustment_motor.set_velocity(controller_2.axis3.position(), PERCENT)

        #height_adjustment_motor.spin(FORWARD)
        motor_group_right.spin(FORWARD)
        motor_group_left.spin(FORWARD)
        wait(5, MSEC)

def autonomous():
    motor_group_left.spin(REVERSE, 50, PERCENT)
    motor_group_right.spin(REVERSE, 50, PERCENT)
    wait(0.9, SECONDS)
    motor_group_left.stop()
    motor_group_right.stop()
    wait(0.5, SECONDS)
    motor_group_left.spin(FORWARD, 25, PERCENT)
    motor_group_right.spin(REVERSE, 25, PERCENT)
    wait(2.5, SECONDS)
    motor_group_left.stop()
    motor_group_right.stop()
    wait(0.5, SECONDS)
    motor_group_left.spin(REVERSE, 100, PERCENT)
    motor_group_right.spin(REVERSE, 100, PERCENT)
    wait(1.5, SECONDS)
    motor_group_left.spin(FORWARD, 50, PERCENT)
    motor_group_right.spin(FORWARD, 50, PERCENT)
    wait(0.9, SECONDS)
    motor_group_left.spin(REVERSE, 100, PERCENT)
    motor_group_right.spin(REVERSE, 100, PERCENT)
    wait(1.5, SECONDS)
    motor_group_left.spin(FORWARD, 50, PERCENT)
    motor_group_right.spin(FORWARD, 50, PERCENT)
    wait(0.5, SECONDS)
    motor_group_right.stop()
    motor_group_left.stop()

# create competition instance
comp = Competition(user_control,autonomous) # This calls the subroutines: we don't need to!

# actions to do when the program starts
brain.screen.clear_screen()
